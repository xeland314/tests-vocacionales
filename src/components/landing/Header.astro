---
const { site, whatsapp } = Astro.props;
---

<header class="sticky top-0 z-30 backdrop-blur bg-white/90 border-b" style="border-color: rgba(31,56,117,0.08)">
  <div class="max-w-295 mx-auto px-5 md:px-6 h-16 flex items-center justify-between gap-4">
    <a href="#inicio" class="flex items-center gap-2.5 shrink-0">
      <img src="/logo-fucsia.png" alt="GGM Preuniversitario — Gestores de experiencias educativas" width="601" height="240" style="height: 34px; width: auto" loading="eager" decoding="async" />
      <span class="hidden lg:inline text-[11px] tracking-widest uppercase font-semibold" style="color: #1f3875">Tests vocacionales · Acceso por Moodle</span>
    </a>
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium" style="color: #001d62">
      <a href="#tests" class="hover:opacity-70 transition-opacity">Tests</a>
      <a href="#personalidad" class="hover:opacity-70 transition-opacity">16 Personalidades</a>
      <a href="#kuder" class="hover:opacity-70 transition-opacity">Kuder</a>
      <a href="#porque" class="hover:opacity-70 transition-opacity">¿Por qué?</a>
    </nav>
    <a href={site} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full px-4 md:px-5 py-2.5 text-sm font-bold text-white transition hover:-translate-y-px shrink-0" style="background: #d8215d; box-shadow: 0 4px 16px rgba(216,33,93,0.28)">
      <span class="hidden sm:inline">Preuniversitario</span> teamggm.com
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg>
    </a>
  </div>
</header>
