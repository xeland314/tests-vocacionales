---
const { site, whatsapp } = Astro.props;
---

<section class="ggm-card p-6 md:p-8 flex flex-col md:flex-row items-center justify-between gap-5 mb-10" style="background: #001d62; border-color: #001d62">
  <div>
    <h2 class="text-[20px] md:text-2xl font-extrabold" style="color: #ffffff">¿Listo para conocerte de verdad?</h2>
    <p class="text-sm mt-1" style="color: rgba(255,255,255,0.78)">Contáctanos, entra al Moodle del pre y rinde tu test de personalidad. Después, el preuniversitario hace el resto.</p>
  </div>
  <div class="flex flex-wrap gap-3 shrink-0">
    <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="ggm-btn-primary inline-flex items-center gap-2 px-6 py-3.5 text-sm">Solicitar acceso</a>
    <a href={site} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full px-6 py-3.5 text-sm font-semibold transition" style="color: #ffffff; border: 1px solid rgba(255,255,255,0.25)">Conocer TeamGGM
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg>
    </a>
  </div>
</section>
