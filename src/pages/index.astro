---
import Layout from "../layouts/Layout.astro";
import Header from "../components/landing/Header.astro";
import HeroSection from "../components/landing/HeroSection.astro";
import TrustBar from "../components/landing/TrustBar.astro";
import TestOverview from "../components/landing/TestOverview.astro";
import LandingCollage from "../components/landing/LandingCollage.astro";
import KuderSection from "../components/landing/KuderSection.astro";
import ImportanceSection from "../components/landing/ImportanceSection.astro";
import HowItWorks from "../components/landing/HowItWorks.astro";
import FinalCTA from "../components/landing/FinalCTA.astro";
import SiteFooter from "../components/landing/SiteFooter.astro";

const SITE = "https://testvocacional.teamggm.com";
const WHATSAPP = `https://wa.me/593967941844?text=${encodeURIComponent("Hola, quiero orientación vocacional para mí o para mi hijo.")}`;

const MBTI_TYPES: { code: string; name: string; slug: string; role: string; color: string }[] = [
  { code: "INTJ", name: "El Estratega", slug: "el-estratega", role: "Analistas", color: "#7C3AED" },
  { code: "INTP", name: "El Lógico", slug: "el-logico", role: "Analistas", color: "#7C3AED" },
  { code: "ENTJ", name: "El Comandante", slug: "el-comandante", role: "Analistas", color: "#7C3AED" },
  { code: "ENTP", name: "El Debatiente", slug: "el-debatiente", role: "Analistas", color: "#7C3AED" },
  { code: "INFJ", name: "El Abogado", slug: "el-abogado", role: "Diplomáticos", color: "#10B981" },
  { code: "INFP", name: "El Mediador", slug: "el-mediador", role: "Diplomáticos", color: "#10B981" },
  { code: "ENFJ", name: "El Protagonista", slug: "el-protagonista", role: "Diplomáticos", color: "#10B981" },
  { code: "ENFP", name: "El Activista", slug: "el-activista", role: "Diplomáticos", color: "#10B981" },
  { code: "ISTJ", name: "El Logista", slug: "el-logista", role: "Centinelas", color: "#0EA5E9" },
  { code: "ISFJ", name: "El Defensor", slug: "el-defensor", role: "Centinelas", color: "#0EA5E9" },
  { code: "ESTJ", name: "El Ejecutivo", slug: "el-ejecutivo", role: "Centinelas", color: "#0EA5E9" },
  { code: "ESFJ", name: "El Cónsul", slug: "el-consul", role: "Centinelas", color: "#0EA5E9" },
  { code: "ISTP", name: "El Virtuoso", slug: "el-virtuoso", role: "Exploradores", color: "#F59E0B" },
  { code: "ISFP", name: "El Aventurero", slug: "el-aventurero", role: "Exploradores", color: "#F59E0B" },
  { code: "ESTP", name: "El Emprendedor", slug: "el-emprendedor", role: "Exploradores", color: "#F59E0B" },
  { code: "ESFP", name: "El Animador", slug: "el-animador", role: "Exploradores", color: "#F59E0B" },
];

const CHASIDE_ROWS: { area: string; label: string; w: number }[] = [
  { area: "C", label: "Administrativas y Contables", w: 71 },
  { area: "H", label: "Humanísticas y Sociales", w: 42 },
  { area: "A", label: "Artísticas", w: 33 },
  { area: "S", label: "Ciencias de la Salud", w: 68 },
  { area: "I", label: "Ingenierías y Computación", w: 57 },
  { area: "D", label: "Defensa y Seguridad", w: 22 },
  { area: "E", label: "Ciencias Exactas y Agrarias", w: 49 },
];

const KUDER_ROWS: { label: string; color: string; w: number }[] = [
  { label: "Científico", color: "#0891B2", w: 82 },
  { label: "Cálculo", color: "#2563EB", w: 74 },
  { label: "Mecánico", color: "#EA580C", w: 69 },
  { label: "Servicio Social", color: "#0D9488", w: 45 },
  { label: "Oficina", color: "#64748B", w: 31 },
];
---

<Layout
  title="Tests vocacionales TeamGGM | MBTI, CHASIDE y Kuder"
  description="Descubre tu tipo, intereses y áreas profesionales con MBTI, CHASIDE y Kuder en TeamGGM."
  keywords="tests vocacionales, MBTI, CHASIDE, Kuder, orientación vocacional, TeamGGM, Quito, Ecuador"
  author="TeamGGM"
  url={SITE}
  image="https://testvocacional.teamggm.com/logo-teamggm-horizontal-con-transparencia.webp"
  imageAlt="Tests vocacionales y de personalidad TeamGGM"
  canonical={`${SITE}/`}
  lang="es"
>

  <Header site={SITE} whatsapp={WHATSAPP} />

  <div id="smooth-wrapper">
    <div id="smooth-content">
      <main id="inicio">
        <div class="max-w-295 mx-auto px-5 md:px-6">
          <HeroSection site={SITE} whatsapp={WHATSAPP} />
          <TrustBar />
          <TestOverview mbtiTypes={MBTI_TYPES} chasideRows={CHASIDE_ROWS} site={SITE} whatsapp={WHATSAPP} />
        </div>

        <LandingCollage />

        <div class="max-w-295 mx-auto px-5 md:px-6 pb-6">
          <KuderSection rows={KUDER_ROWS} site={SITE} whatsapp={WHATSAPP} />
          <ImportanceSection />
          <HowItWorks site={SITE} whatsapp={WHATSAPP} />
          <FinalCTA site={SITE} whatsapp={WHATSAPP} />
        </div>
      </main>

      <SiteFooter site={SITE} whatsapp={WHATSAPP} />
    </div>
  </div>

  <script>
    import { gsap } from "gsap";
    import { Draggable } from "gsap/Draggable";
    import { Flip } from "gsap/Flip";
    import { ScrambleTextPlugin } from "gsap/ScrambleTextPlugin";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { ScrollSmoother } from "gsap/ScrollSmoother";
    import { ScrollToPlugin } from "gsap/ScrollToPlugin";
    import { SplitText } from "gsap/SplitText";
    import { TextPlugin } from "gsap/TextPlugin";

    gsap.registerPlugin(
      Draggable,
      Flip,
      ScrambleTextPlugin,
      ScrollTrigger,
      ScrollSmoother,
      ScrollToPlugin,
      SplitText,
      TextPlugin
    );

    const smoothWrapper = document.getElementById("smooth-wrapper");
    const smoothContent = document.getElementById("smooth-content");

    if (smoothWrapper && smoothContent) {
      ScrollSmoother.create({
        wrapper: smoothWrapper,
        content: smoothContent,
        smooth: 1.15,
        effects: true,
        normalizeScroll: true,
      });

      const animatedElements = gsap.utils.toArray("section, article, .ggm-card") as HTMLElement[];

      animatedElements.forEach((element) => {
        gsap.from(element, {
          y: 30,
          opacity: 0,
          duration: 0.8,
          ease: "power2.out",
          scrollTrigger: {
            trigger: element,
            start: "top 82%",
          },
        });
      });

      document.querySelectorAll('a[href^="#"]').forEach((link) => {
        link.addEventListener("click", (event) => {
          const targetId = link.getAttribute("href");
          if (!targetId || targetId === "#") return;

          const target = document.querySelector(targetId);
          if (!target) return;

          event.preventDefault();
          gsap.to(window, {
            duration: 1.1,
            ease: "power3.inOut",
            scrollTo: { y: target, offsetY: 80 },
          });
        });
      });
    }
  </script>

  <style>
    .ggm-card {
      background: #fcfcfc;
      border: 1px solid rgba(31, 56, 117, 0.08);
      border-radius: 16px;
      transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
    }
    .ggm-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 32px rgba(0, 29, 98, 0.08);
      border-color: rgba(31, 56, 117, 0.14);
    }
    .ggm-btn-primary {
      background: #d8215d;
      color: #fff;
      border-radius: 9999px;
      font-weight: 700;
      transition: transform 150ms ease, box-shadow 150ms ease, background 150ms ease;
      box-shadow: 0 4px 16px rgba(216, 33, 93, 0.28);
    }
    .ggm-btn-primary:hover {
      background: #b81c4f;
      transform: translateY(-1px);
      box-shadow: 0 8px 24px rgba(216, 33, 93, 0.36);
    }
    #smooth-wrapper {
      overflow: hidden;
    }

    #smooth-content {
      position: relative;
    }

    .censor {
      user-select: none;
    }
  </style>
</Layout>
