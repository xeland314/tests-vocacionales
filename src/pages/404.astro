---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="min-h-[70vh] bg-[#ffffff] flex items-center justify-center p-4">
    <div class="max-w-md w-full bg-[#fcfcfc] border border-[#0f2b6b]/10 rounded-2xl p-8 text-center">
      <img src="/logo-fucsia.png" alt="TEAM GGM" class="h-10 mx-auto mb-6" />
      <h1 class="text-6xl font-black text-[#001d62]" style="font-family: Poppins, system-ui, sans-serif">404</h1>
      <p class="text-sm text-[#0f2b6b] mt-2">Página no encontrada.</p>
      <p class="text-xs text-[#0f2b6b]/60 mt-1">La página que buscas no existe o fue movida.</p>
      <a href="/" class="mt-6 inline-block bg-[#001d62] hover:bg-[#0f2b6b] text-white px-6 py-2.5 rounded-full font-bold">Ir al inicio</a>
    </div>
  </div>
</Layout>
