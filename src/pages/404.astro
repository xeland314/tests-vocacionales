---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Página no encontrada | TeamGGM"
  description="La página que buscas no existe o fue movida. Regresa al inicio para continuar explorando los tests vocacionales de TeamGGM."
  keywords="404, página no encontrada, TeamGGM"
  author="TeamGGM"
  url="https://testvocacional.teamggm.com/404"
  canonical="https://testvocacional.teamggm.com/404"
  image="https://testvocacional.teamggm.com/logo-teamggm-horizontal-con-transparencia.webp"
  imageAlt="Página no encontrada TeamGGM"
  robots="noindex, nofollow"
>
  <div class="min-h-[70vh] bg-[#ffffff] flex items-center justify-center p-4">
    <div class="max-w-md w-full bg-[#E1E3DA] border border-[#164F8D]/10 rounded-2xl p-8 text-center">
      <img src="/logo-fucsia.png" alt="TEAM GGM" class="h-10 mx-auto mb-6" />
      <h1 class="text-6xl font-black text-[#1D60A9]" style="font-family: Poppins, system-ui, sans-serif">404</h1>
      <p class="text-sm text-[#164F8D] mt-2">Página no encontrada.</p>
      <p class="text-xs text-[#164F8D]/60 mt-1">La página que buscas no existe o fue movida.</p>
      <a href="/" class="mt-6 inline-block bg-[#1D60A9] hover:bg-[#164F8D] text-white px-6 py-2.5 rounded-full font-bold">Ir al inicio</a>
    </div>
  </div>
</Layout>
